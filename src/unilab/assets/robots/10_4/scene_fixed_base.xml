<?xml version="1.0" ?>
<mujoco model="10.4 fixed-base observation scene">
  
  
  <include file="10_4_fixed_base.xml"/>
  <!-- Observation-only setup: weld the chassis 0.8 m above the world. -->
  <equality>
    <weld name="base_fixed_observation" body1="world" body2="base_link"
          relpose="0 0 0.8 1 0 0 0"
          solref="0.001 1" solimp="0.99 0.99 0.01 0.5 2"/>
  </equality>
  
  
  <statistic center="0 0 0.2" extent="0.8"/>
  
  
  <visual>
    
    
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    
    
    <rgba haze="0.15 0.25 0.35 1"/>
    
    
    <global azimuth="-130" elevation="-20"/>
    
  
  </visual>
  
  
  <asset>
    
    
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    
    
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    
    
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    
  
  </asset>
  
  
  <worldbody>
    
    
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    
    
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
  
  </worldbody>
  
  
  <contact>
    
    
    <pair geom1="left_wheel_ground_contact" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="left_front_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="left_front1_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="left_bottom1_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="left_bottom2_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="left_bottom3_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="left_bottom4_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="right_wheel_ground_contact" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="right_front_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="right_front1_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="right_bottom1_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="right_bottom2_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="right_bottom3_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
    
    <pair geom1="right_bottom4_guide_link_collision" geom2="floor" solref="0.02 1" solimp="0.8 0.95 0.002 0.9 2"/>
    
  
  </contact>
  
  
  <!-- Observation controls. Each slider is a delta angle around the CAD home pose.
       The larger force range is intentional: the two gas springs add roughly
       26--35 N m of opposing torque before the passive-loop reaction forces.
       Keep the six inherited torque motors at zero while using these controls,
       and move the rear1/front1 pair on a leg together. -->
  <actuator>
    <general name="interactive_left_rear1_delta" joint="left_rear1_joint"
             gaintype="fixed" gainprm="80" biastype="affine"
             biasprm="16.07844 -80 -4" ctrlrange="-6.283185307 6.283185307" forcerange="-120 120"/>
    <general name="interactive_left_front1_delta" joint="left_front1_joint"
             gaintype="fixed" gainprm="80" biastype="affine"
             biasprm="-41.36336 -80 -4" ctrlrange="-6.283185307 6.283185307" forcerange="-120 120"/>
    <general name="interactive_right_rear1_delta" joint="right_rear1_joint"
             gaintype="fixed" gainprm="80" biastype="affine"
             biasprm="-16.07844 -80 -4" ctrlrange="-6.283185307 6.283185307" forcerange="-120 120"/>
    <general name="interactive_right_front1_delta" joint="right_front1_joint"
             gaintype="fixed" gainprm="80" biastype="affine"
             biasprm="41.36336 -80 -4" ctrlrange="-6.283185307 6.283185307" forcerange="-120 120"/>
  </actuator>


  <sensor>
    
    
    <contact name="left_wheel_contact" geom1="floor" geom2="left_wheel_ground_contact" data="found" num="1" reduce="mindist"/>
    
    
    <contact name="left_front_guide_contact" geom1="floor" geom2="left_front_guide_link_collision" data="found" num="1" reduce="mindist"/>
    
    
